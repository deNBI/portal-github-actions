
{
  "$schema": "https://docs.renovatebot.com/renovate-bot/schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlerts"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "rangeStrategy": "bump",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "groupName": "Security Updates"
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group development dependencies",
      "matchDepTypes": [
        "devDependencies",
        "dev"
      ],
      "groupName": "Development Dependencies"
    },
    {
      "description": "Group Python patch updates",
      "matchManagers": [
        "pip_requirements",
        "pip_setup",
        "poetry",
        "pep621"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Python Patch Updates"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Prioritize security updates",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "matchVulnerabilityAlerts": true,
      "priority": 10,
      "automerge": false
    }
  ]
}
