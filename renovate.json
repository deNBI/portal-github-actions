{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "libc6_2.39-0ubuntu8.9_amd64.deb",
    "plans"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["internal"],
      "description": "Self-referencing actions use @main - do not propose digest pins or updates to avoid an endless PR loop.",
      "enabled": false,
      "minimumReleaseAge": false
    },
    {
      "description": "Limit digest-only update PRs to once per day to avoid PR churn",
      "matchUpdateTypes": ["digest"],
      "schedule": [
        "before 11pm every day"
      ]
    }
  ]
}
